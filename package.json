{
  "name": "doska",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo run dev --filter=!desktop --filter=!mobile",
    "build": "turbo run build --filter=!desktop --filter=!mobile",
    "desktop": "pnpm --filter desktop dev",
    "mobile": "pnpm --filter mobile dev",
    "mobile-device": "pnpm --filter mobile exec expo run:ios --device",
    "mobile-install": "pnpm --filter mobile exec expo run:ios --device --configuration Release",
    "lint": "turbo run lint",
    "type-check": "turbo run typecheck",
    "test": "turbo run test --filter=!desktop",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "e2e": "turbo run e2e --filter=!desktop",
    "e2e:ui": "pnpm --filter @doska/e2e e2e:ui",
    "upd": "pnpm dlx npm-check-updates --workspaces --root -i"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2"
  }
}
